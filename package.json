{
  "name": "elysia-longevity-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first longevity ecosystem monorepo scaffold.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run -ws typecheck",
    "lint": "npm run -ws lint",
    "test": "npm run -ws test && npm run test:convex",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "test:convex:watch": "vitest --config convex/vitest.config.ts",
    "mobile": "npm run start -w @elysia/mobile",
    "mobile:clear": "npm run start:clear -w @elysia/mobile",
    "mobile:dev": "npm run start:dev -w @elysia/mobile",
    "expo": "npm run mobile",
    "expo:clear": "npm run mobile:clear",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@polar-sh/sdk": "^0.46.6",
    "convex": "^1.34.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}
